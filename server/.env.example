# Copy to .env and fill in. Never commit .env.

PORT=3001
NODE_ENV=development

# MySQL — same database the PHP app uses
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Comma-separated list of admin passwords (replaces the hardcoded ones in php/loginGateway.php)
ADMIN_PASSWORDS=

# Long random string used to sign the session cookie
SESSION_SECRET=

# SMTP for the game-misconduct notification email (optional — skipped if SMTP_HOST is blank)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MISCONDUCT_NOTIFY_TO=
PUBLIC_SITE_URL=
